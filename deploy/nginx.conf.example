# Inside the HTTPS server block of your site. Create the password file with
#   htpasswd -c /etc/nginx/blindtrace.htpasswd annotators
location ^~ /blindtrace/ {
    auth_basic "BlindTrace";
    auth_basic_user_file /etc/nginx/blindtrace.htpasswd;
    proxy_pass http://127.0.0.1:8170;
    proxy_set_header Host $host;
    client_max_body_size 4m;
}
location = /blindtrace { return 301 /blindtrace/; }
